{#=====================================================
  Project creation page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>Define Milestones</h2>
   
    <section id="content">

        Project: {{ project.name }}
        <br>
        Description: {{ project.desc }}

        <h3>Current Milestones</h3>

        <ul>
            {% for milestone in milestones %}
                {% if milestone.project_id == project_id %}
                    <li>{{ milestone.name }}</li>
                {% endif %}
            {% endfor%}
        </ul>

        <br>

        <h4>New Milestone</h4>

        <form method="post" action="/addm">

            <label>
                Name
                <input name="name" type="text" required>
            </label>

            <br>

            <label>
                Complete
                <input name="status" type="checkbox">
            </label>

            <br>

            <button>Add</button>

            <br>
        </form>

        <button><a href="/show/{{project.id}}">Finish</a></button>
    </section>


{% endblock %}

