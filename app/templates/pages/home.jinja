{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>Main page</h2>

    <section id="content">

       <form method="post" action="/search">
    
            <label>
                Search tracker ID
                <input name="id" type="int" required>
            </label>

            <button>Search</button>
        </form>

    
        {% if session.logged_in %}
            <section class="link">
                <a href="/project/new">New Project</a>
            </section>
            <p>My projects:</p>
                <section class="link">
                    {% for project in projects %}
                        <li><a href="/show/{{project.id}}">{{project.name}}</a></li>
                    {% endfor %}
                </section>
        {% endif %}

    </section>

{% endblock %}

