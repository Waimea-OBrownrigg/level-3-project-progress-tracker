{#=====================================================
  Project creation page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <section id="form">

        <form method="post" action="/update/{{p_info.id}}">

                <label>
                    Name
                    <input name="name" type="text" value="{{ p_info.name }}" required>
                </label>

                <br>

                <label>
                    Description
                    <input name="desc" type="text" value="{{ p_info.desc }}">
                </label>

                <br>

                {% for m_info in m_info %}
                    <label>
                        Milestone: {{ m_info.name }}
                        <input name="status{{m_info.id}}" type="checkbox" {{ 'checked' if m_info.status == 1 }}>
                    </label>
                    <br>
                {% endfor%}

                <button>Submit</button>
        </form>

    </section>

{% endblock %}

